# Server
PORT=5000

# MongoDB connection string (database name can be appended as a query param,
# e.g. ...?retryWrites=true&w=majority&dbName=library)
MONGODB_URL=your_mongodb_connection_string

# GitHub OAuth app credentials
# Create the app at https://github.com/settings/developers
# Authorization callback URL must be:
#   https://YOUR-RENDER-URL.onrender.com/auth/github/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Exact callback URL registered with GitHub (one per environment)
# Local:   http://localhost:5000/auth/github/callback
# Render:  https://YOUR-RENDER-URL.onrender.com/auth/github/callback
CALLBACK_URL=http://localhost:5000/auth/github/callback

# Secret used to sign session cookies (use a long random string)
SESSION_SECRET=your_session_secret