@baseUrl = http://localhost:5000
@token = paste_your_oauth_token_here

### Health check
GET {{baseUrl}}/

### =============================================================
### AUTH (GitHub OAuth + JWT)
### =============================================================

### Step 1: start the OAuth flow (opens GitHub consent screen in the browser)
GET {{baseUrl}}/auth/github

### Step 2: GitHub redirects to /auth/github/callback, which returns a token.
### Copy the "token" value from that response into @token above.

### Who am I? (requires a valid token — expect 200)
GET {{baseUrl}}/auth/user
Authorization: Bearer {{token}}

### Who am I? without a token (expect 401)
GET {{baseUrl}}/auth/user

### Logout
GET {{baseUrl}}/auth/logout

### =============================================================
### BOOKS — POST and PUT are protected by OAuth
### =============================================================

### List books (public — expect 200)
GET {{baseUrl}}/books

### Get one book (public — expect 200 or 404)
GET {{baseUrl}}/books/6abdb7cfe24118902000af89

### Create a book WITH token (expect 201)
# @name createBook
POST {{baseUrl}}/books
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "One Hundred Years of Solitude",
  "isbn": "978-0-06-088328-7",
  "authorId": "A004",
  "categoryId": "C001",
  "publishedYear": 1967,
  "pages": 417,
  "summary": "The multi-generational story of the Buendia family in the fictional town of Macondo."
}

### Create a book WITHOUT token (expect 401)
POST {{baseUrl}}/books
Content-Type: application/json

{
  "title": "Unauthorized book",
  "isbn": "978-0-00-000000-1",
  "authorId": "A004",
  "categoryId": "C001",
  "publishedYear": 2025,
  "pages": 100,
  "summary": "Should be rejected"
}

### Get the created book
GET {{baseUrl}}/books/{{createBook.response.body.$._id}}

### Update the created book WITH token (expect 200)
PUT {{baseUrl}}/books/{{createBook.response.body.$._id}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "One Hundred Years of Solitude",
  "isbn": "978-0-06-088328-7",
  "authorId": "A004",
  "categoryId": "C001",
  "publishedYear": 1967,
  "pages": 417,
  "summary": "Updated summary for One Hundred Years of Solitude."
}

### Update WITHOUT token (expect 401)
PUT {{baseUrl}}/books/6abdb7cfe24118902000af89
Content-Type: application/json

{
  "title": "Unauthorized update",
  "isbn": "978-0-00-000000-1",
  "authorId": "A004",
  "categoryId": "C001",
  "publishedYear": 2025,
  "pages": 100,
  "summary": "Should be rejected"
}

### Delete the created book (expect 200)
DELETE {{baseUrl}}/books/{{createBook.response.body.$._id}}

### =============================================================
### AUTHORS — POST and PUT are protected by OAuth
### =============================================================

### List authors (public — expect 200)
GET {{baseUrl}}/authors

### Get one author (public — expect 200 or 404)
GET {{baseUrl}}/authors/6abdb7cfe24118902000af89

### Create an author WITH token (expect 201)
# @name createAuthor
POST {{baseUrl}}/authors
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "firstName": "Gabriel",
  "lastName": "Garcia Marquez",
  "birthDate": "1927-03-06",
  "nationality": "Colombian",
  "biography": "Colombian novelist and journalist, widely known for One Hundred Years of Solitude.",
  "books": ["B004"],
  "awards": ["Nobel Prize in Literature 1982"]
}

### Create an author WITHOUT token (expect 401)
POST {{baseUrl}}/authors
Content-Type: application/json

{
  "firstName": "Unauthorized",
  "lastName": "Author",
  "birthDate": "1990-01-01",
  "nationality": "Nowhere",
  "biography": "Should be rejected",
  "books": [],
  "awards": []
}

### Get the created author
GET {{baseUrl}}/authors/{{createAuthor.response.body.$._id}}

### Update the created author WITH token (expect 200)
PUT {{baseUrl}}/authors/{{createAuthor.response.body.$._id}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "firstName": "Gabriel",
  "lastName": "Garcia Marquez",
  "birthDate": "1927-03-06",
  "nationality": "Colombian",
  "biography": "Updated biography for Gabriel Garcia Marquez.",
  "books": ["B004"],
  "awards": ["Nobel Prize in Literature 1982"]
}

### Delete the created author (expect 200)
DELETE {{baseUrl}}/authors/{{createAuthor.response.body.$._id}}

### =============================================================
### CATEGORIES — new collection (open CRUD)
### =============================================================

### List categories (expect 200)
GET {{baseUrl}}/categories

### Create a category (expect 201)
# @name createCategory
POST {{baseUrl}}/categories
Content-Type: application/json

{
  "name": "Classic Fiction",
  "description": "Timeless novels considered part of the literary canon."
}

### Get the created category
GET {{baseUrl}}/categories/{{createCategory.response.body.$._id}}

### Update the created category (expect 200)
PUT {{baseUrl}}/categories/{{createCategory.response.body.$._id}}
Content-Type: application/json

{
  "name": "Classic Fiction",
  "description": "Updated description for timeless novels considered part of the literary canon."
}

### Delete the created category (expect 200)
DELETE {{baseUrl}}/categories/{{createCategory.response.body.$._id}}

### Validation check: category name is required (expect 400)
POST {{baseUrl}}/categories
Content-Type: application/json

{
  "description": "Missing the category name"
}

### =============================================================
### MEMBERS — new collection (open CRUD)
### =============================================================

### List members (expect 200)
GET {{baseUrl}}/members

### Create a member (expect 201)
# @name createMember
POST {{baseUrl}}/members
Content-Type: application/json

{
  "firstName": "Jordan",
  "lastName": "Smith",
  "email": "jordan.smith@example.com",
  "phone": "208-555-0142",
  "membershipType": "Student"
}

### Get the created member
GET {{baseUrl}}/members/{{createMember.response.body.$._id}}

### Update the created member (expect 200)
PUT {{baseUrl}}/members/{{createMember.response.body.$._id}}
Content-Type: application/json

{
  "firstName": "Jordan",
  "lastName": "Smith",
  "email": "jordan.smith@example.com",
  "phone": "208-555-0199",
  "membershipType": "Graduate Student"
}

### Delete the created member (expect 200)
DELETE {{baseUrl}}/members/{{createMember.response.body.$._id}}

### Validation check: member email is required (expect 400)
POST {{baseUrl}}/members
Content-Type: application/json

{
  "firstName": "No",
  "lastName": "Email",
  "phone": "208-555-0100",
  "membershipType": "Faculty"
}

### Validation check: member email format is invalid (expect 400)
POST {{baseUrl}}/members
Content-Type: application/json

{
  "firstName": "Bad",
  "lastName": "Email",
  "email": "not-an-email",
  "phone": "208-555-0100",
  "membershipType": "Faculty"
}

### =============================================================
### VALIDATION CHECKS on the original two collections
### =============================================================

### Validation check: author firstName is required (expect 401 without token, 400 with token)
POST {{baseUrl}}/authors
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "lastName": "Missing",
  "birthDate": "2000-01-01",
  "nationality": "Nowhere",
  "biography": "Invalid test record",
  "books": [],
  "awards": []
}

### Validation check: book authorId is required (expect 401 without token, 400 with token)
POST {{baseUrl}}/books
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Book without an author code",
  "isbn": "978-0-00000-000-0",
  "categoryId": "C001",
  "publishedYear": 2025,
  "pages": 100,
  "summary": "Invalid test record"
}

### Validation check: invalid book ID on GET (expect 400)
GET {{baseUrl}}/books/not-a-valid-id

### Validation check: invalid category ID on GET (expect 400)
GET {{baseUrl}}/categories/not-a-valid-id

### Validation check: invalid member ID on GET (expect 400)
GET {{baseUrl}}/members/not-a-valid-id
